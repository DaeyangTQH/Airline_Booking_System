# Copy thành infra/.env và điền giá trị local.
# Mọi service + api-gateway import file này (spring.config.import).
# Không commit file infra/.env.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxx
POSTGRES_DEFAULT_DB=postgres
POSTGRES_PORT=5432

# ==========================
# BOOKING SERVICE
# ==========================
BOOKING_DB_URL=jdbc:postgresql://localhost:5432/booking_db
BOOKING_DB_USERNAME=postgres
BOOKING_DB_PASSWORD=xxx
BOOKING_SERVICE_PORT=8082
BOOKING_EXPIRATION_FIXED_DELAY_MS=60000
INTERNAL_API_KEY=xxxx

# ==========================
# USER SERVICE
# ==========================
USER_DB_URL=jdbc:postgresql://localhost:5432/user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=xxx
USER_SERVICE_PORT=8081

# ==========================
# PAYMENT SERVICE
# ==========================
PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/payment_db
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=xxx
PAYMENT_SERVICE_PORT=8084

DB_URL=jdbc:postgresql://localhost:5432/payment_db
DB_USERNAME=postgres
DB_PASSWORD=xxx
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ==========================
# NOTIFICATION SERVICE
# ==========================
NOTIFICATION_DB_URL=jdbc:postgresql://localhost:5432/notification_db
NOTIFICATION_DB_USERNAME=postgres
NOTIFICATION_DB_PASSWORD=xxx
NOTIFICATION_SERVICE_PORT=8085

# ==========================
# JWT (user-service + api-gateway)
# Base64 ≥ 32 bytes
# ==========================
USER_JWT_SECRET=xxx

# ==========================
# EUREKA
# ==========================
EUREKA_CLIENT_SERVICE_URL=http://localhost:8761/eureka/

# ==========================
# SEPAY (QR + Webhook)
# ==========================
# Test Mode: ACMEBank + VA SBPAY... | Live: MBBank/Vietcombank/...
SEPAY_ACCOUNT_NUMBER=SBPAY7605943182
SEPAY_BANK_CODE=ACMEBank
SEPAY_ACCOUNT_HOLDER=TRAN QUOC HAI
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
SEPAY_CHECKOUT_BASE_URL=http://localhost:8084
SEPAY_WEBHOOK_API_KEY=xxx
SEPAY_PAYMENT_CODE_PREFIX=AIR
SEPAY_PAYMENT_CODE_SUFFIX_LENGTH=12
